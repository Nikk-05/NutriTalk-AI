# Vite env vars must be prefixed VITE_ to be exposed to the browser bundle.
# Copy this to `.env.local` for local dev, or set these in your hosting
# provider's dashboard (Cloudflare Pages → Settings → Environment variables).

# Node.js backend base URL (include /api suffix, no trailing slash)
# Local:       http://localhost:3000/api
# Production:  https://api.your-domain.com/api
VITE_NODE_BASE_URL=http://localhost:3000/api

# FastAPI AI service base URL (no /api suffix, no trailing slash)
# The frontend never calls this directly — Node proxies via /api/ai/* —
# but the constant is kept here in case any page needs a direct ref.
# Local:       http://localhost:8000
# Production:  https://ai.your-domain.com
VITE_AI_SERVICE_URL=http://localhost:8000
